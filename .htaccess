# ===========================================================================
#  Velia — velialaser.com — configuration Apache (hébergement OVH mutualisé)
# ===========================================================================

# Page d'accueil et page d'erreur
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Pas de listing des dossiers
Options -Indexes

# Encodage par défaut
AddDefaultCharset UTF-8


# ---------------------------------------------------------------------------
#  1. HTTPS + domaine unique (actif)
# ---------------------------------------------------------------------------
#  Certificat SSL actif depuis le 15/11/2026 : les redirections sont en place.
#  Toute visite en http:// ou sur www. est renvoyee en 301 vers
#  https://velialaser.com, l'adresse declaree comme canonique.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://velialaser.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.velialaser\.com$ [NC]
  RewriteRule ^ https://velialaser.com%{REQUEST_URI} [R=301,L]
</IfModule>


# ---------------------------------------------------------------------------
#  2. Compression — divise par ~4 le poids du HTML et du CSS
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# ---------------------------------------------------------------------------
#  3. Mise en cache navigateur
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  # le HTML doit rester frais : les tarifs peuvent changer
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>


# ---------------------------------------------------------------------------
#  4. Sécurité
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header unset X-Powered-By
</IfModule>


# ---------------------------------------------------------------------------
#  5. Types MIME
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2                  .woff2
  AddType application/manifest+json   .webmanifest
  AddType image/x-icon                .ico
</IfModule>
